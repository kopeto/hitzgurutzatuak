# Copia este archivo a .env y ajusta los valores

# Puerto del servidor
PORT=3000

# MongoDB connection string
MONGO_URI=mongodb://localhost:27017/hitzgurutzatuak

# Secret para sesiones (CAMBIAR en producción con algo como: openssl rand -base64 32)
SESSION_SECRET=your_super_secret_key_here_change_this_in_production

# Lista de usuarios master separados por espacios
MASTERS=admin user1

# Entorno (development | production)
NODE_ENV=development
