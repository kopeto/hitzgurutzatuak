# Tokiko Docker konfigurazioa. Ez erabili balio hauek produkzioan.
# Produkzio sekretuak zerbitzarian /etc/hitzgurutzatuak/app.env fitxategian gorde.
DB_CONNECTION=mongodb://mongo:27017/HG_develop
MY_SECRET=local-only-session-secret-change-this-if-shared
EXTERNAL_API_KEY=local-only-external-api-key
SESSION_COOKIE_SECURE=false
LOCAL_HTTP_MODE=true
TRUST_PROXY=false
SESSION_MAX_AGE_MS=604800000

# Aukerakoa: master bihurtu beharreko erabiltzaile IDak, komaz bereizita.
# node scripts/sync-masters.js komandoak bakarrik erabiltzen du.
MASTER_USER_IDS=
