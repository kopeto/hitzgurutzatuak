# Garapen lokaleko txantiloia. Ez erabili balio hauek produkzioan.
# Produkzio sekretuak zerbitzarian edo hornitzailearen secret managerrean gorde.
# Sortu sekretuak komando honekin: openssl rand -base64 32
# Sortu sekretuak komando honekin: openssl rand -base64 32

NODE_ENV=development
PORT=3000

# MongoDB
DB_CONNECTION=mongodb://127.0.0.1:27017/HG_develop

# Saioaren sekretua (luzea eta ausazkoa)
MY_SECRET=pon_aqui_un_secreto_largo_y_aleatorio
SESSION_MAX_AGE_MS=604800000

# Proxy alderantzikatu fidagarri baten atzean soilik aktibatu.
TRUST_PROXY=false

# .puz fitxategien gehienezko tamaina, bytetan.
MAX_PUZ_UPLOAD_BYTES=5242880

# Puzleak kargatzeko kanpoko APIaren gakoa.
EXTERNAL_API_KEY=pon_aqui_una_api_key_segura

# Aukerakoa: master bihurtu beharreko erabiltzaile IDak, komaz bereizita.
# node scripts/sync-masters.js komandoak bakarrik erabiltzen du.
MASTER_USER_IDS=
