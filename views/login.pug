extend layout

block content
  section.auth-layout
    .auth-intro
      p.eyebrow #{t('auth.loginEyebrow')}
      h1 #{t('auth.loginTitle')}
      p #{t('auth.loginText')}
    .auth-card
      h2 #{t('auth.login')}
      form.auth-form(method='POST', action='/users/login')
        .form-group
          label(for='username') #{t('auth.username')}
          input#username.form-control(name='username', type='text', autocomplete='username', required, autofocus)
        .form-group
          label(for='password') #{t('auth.password')}
          input#password.form-control(name='password', type='password', autocomplete='current-password', required)
        button.btn.btn-primary.btn-block(type='submit') #{t('auth.enter')}
      p.auth-footer #{t('auth.noAccount')} #[a(href='/users/register') #{t('nav.createAccount')}]
