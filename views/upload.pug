extends layout

block content
  section.form-page
    .page-heading
      .page-heading-copy
        p.eyebrow #{t('upload.eyebrow')}
        h1 #{t('upload.title')}
        p #{t('upload.intro')}
      .page-actions
        if user && user.master
          a.btn.btn-outline-secondary(href='/jokoak/spiral-builder') #{t('upload.builder')}
        a.btn.btn-outline-primary(href='/jokoak') #{t('upload.backToCatalog')}
    .upload-card
      form.auth-form(method='POST', action='/jokoak/upload', enctype='multipart/form-data')
        .form-group
          label(for='filename') #{t('upload.file')}
          input#filename.form-control(name='filename', type='file', accept='.ipuz,.puz,.spl', required)
          small.form-hint #{t('upload.hint')}
        button.btn.btn-primary(type='submit') #{t('upload.submit')}
