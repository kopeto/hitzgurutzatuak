extends layout

block scripts
	script(src='/vendor/jquery/jquery.min.js')
	script(src='/scripts/game_api.js')
	script(src='/scripts/cw_scripts.js')
	script(src='/scripts/jquery_scrollto.js')
block meta
	meta(name='description' content=`${puz.name} — ${puz.author} — ${puz.width}×${puz.height} — Hitzgurutzatuak`)
	meta(property='og:title' content=`${puz.name} | Hitzgurutzatuak`)
	meta(property='og:description' content=`${puz.author}en hitz-gurutzatua — Hitz jokoen jokoa`)
	meta(property='og:type' content='website')
block styles
	link(rel='stylesheet', href='/style/cw.css')

block content
	.game-topbar
		a(href='/puzzles')
			button.btn.btn-sm.btn-outline-secondary Atzera jo
		h2.game-title #{puz.name}

	.game-wrapper(data-puzzle-id=puz.id)
		div.puzzle
			div.grid-block
				table.grid.unselectable#jokoa(tabindex='-1')
					tbody
						each row,i in puz.void_grid
							tr
								each cell,j in row
									- let id='c_'+i+'_'+j
									if cell=='.'
										td.black(id=id)
									else
										- let cellNum = null
										for word in puz.words
											if word.x == i && word.y == j && cellNum === null
												- cellNum = word.number
										td(id=id)
											if cellNum !== null
												span.i_words #{cellNum}
											span.char
												
				div.history-bar
					button#undo_btn.btn.btn-sm.btn-outline-secondary(type='button' disabled) &#8630; Desegin
					button#redo_btn.btn.btn-sm.btn-outline-secondary(type='button' disabled) &#8631; Berregin

			div.clues.unselectable
				strong EZKER ESKUIN
				div.clues_across
					each word,i in puz.words
						if word.dir=='right'
							- let id = 'clueacross_'+word.number+'_'+word.x+'_'+word.y;
							div(id=id) #{word.number} #{puz.clues[i]}
				strong GOITIK BEHERA
				div.clues_down
					each word,i in puz.words
						if word.dir=='down'
							- let id = 'cluedown_'+word.number+'_'+word.x+'_'+word.y;
							div(id=id) #{word.number} #{puz.clues[i]}

		#game-notification.game-notification-bar

		nav.buttons
			div.btn-section
				span.btn-section-label Zuzendu
				button#check_cell.btn.btn-outline-secondary(type='button') Hizkia
				button#check_word.btn.btn-outline-secondary(type='button') Hitza
			div.btn-section
				span.btn-section-label Bete
				button#solve_cell.btn.btn-outline-secondary(type='button') Hizkia
				button#solve_word.btn.btn-outline-secondary(type='button') Hitza
				button#solve_grid.btn.btn-outline-secondary(type='button') Koadroa
			button#delete_all.btn.btn-outline-danger(type='button') Koadroa garbitu
			button#check_grid.btn.btn-primary.btn-check-grid(type='button') ✓ Zuzendu koadroa

block footer
	p #{puz.author} - #{puz.name}
