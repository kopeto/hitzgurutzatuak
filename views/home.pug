extends layout

block content
  section.hero
    .hero-copy
      p.eyebrow #{t('home.eyebrow')}
      h1 #{t('home.title')}
      p.hero-text #{t('home.intro')}
      .hero-actions
        a.btn.btn-primary.btn-lg(href='/jokoak') #{t('home.browse')}
        if !user
          a.btn.btn-outline-light.btn-lg(href='/users/register') #{t('nav.createAccount')}
    .hero-panel(aria-hidden='true')
      .hero-grid
        - const cells = ['H','I','T','Z',null,null,'P','I','K',null,'J','O','K','O','A','O','T','I',null,'K',null,'X',null,'',null]
        - const featuredCellIndexes = [0,1,2,3,10,11,12,13,14,19]
        each cell, index in cells
          span(class=(cell === null ? 'hero-cell hero-cell--dark' : 'hero-cell') + (featuredCellIndexes.includes(index) ? ' hero-cell--featured' : '')) #{cell}

  section.section-heading
    .section-heading-copy
      p.eyebrow #{t('home.latestEyebrow')}
      h2 #{t('home.latest')}
    a.section-link(href='/jokoak') #{t('home.allCatalog')}

  if puzzles.length
    .puzzle-list
      each puz in puzzles
        article.puzzle-list-item
          .puzzle-list-dimension #{puz.width}×#{puz.height}
          .puzzle-list-content
            h3
              a(href=`/jokoak/game/${puz._id}`) #{puz.name}
            p.puzzle-author #{puz.author || t('common.unknownAuthor')}
          .puzzle-list-meta
            span.puzzle-new #{t('home.new')}
            span #{puz.createdAt ? new Date(puz.createdAt).toLocaleDateString('eu') : '—'}
          a.btn.btn-primary.btn-sm(href=`/jokoak/game/${puz._id}` aria-label=t('home.playAria', { name: puz.name })) #{t('common.play')}
  else
    .empty-state
      h2 #{t('home.emptyTitle')}
      p #{t('home.emptyText')}
