- const puzzle = data.puzzle
- const displayClue = clue => { const text = String(clue || '').trim(); return !text || /^ninguna pista\.?$/i.test(text) ? '-' : text; }
- const groupedDefinitions = direction => { const grouped = new Map(); puzzle.words.filter(word => word.dir === direction).forEach(word => { const coordinate = direction === 'right' ? word.x : word.y; if (!grouped.has(coordinate)) grouped.set(coordinate, []); grouped.get(coordinate).push(word); }); return [...grouped.entries()].sort((a, b) => a[0] - b[0]); }
section(data-crossword-game data-default-layout='xedera')
  .game-topbar
    a(href='/jokoak'): button.btn.btn-sm.btn-outline-secondary(type='button')= t('common.back')
    h2.game-title= puzzle.name
    if user
      span.game-timer(data-game-timer) 00:00
  .game-wrapper
    .puzzle
      .grid-block.clue-layout-xedera(data-grid-block style=`--grid-cols:${puzzle.width};--grid-rows:${puzzle.height}`)
        .grid.unselectable(data-crossword-grid role='grid' aria-label=t('game.gridLabel', { name: puzzle.name }))
          each col in Array.from({length:puzzle.width}, (_, i) => i)
            span.axis-label.axis-top-label(data-axis='column' style=`grid-column:${col + 2};grid-row:1` aria-hidden='true')= col + 1
          each row in Array.from({length:puzzle.height}, (_, i) => i)
            span.axis-label.axis-left-label(data-axis='row' style=`grid-column:1;grid-row:${row + 2}` aria-hidden='true')= row + 1
          each cells, row in puzzle.void_grid
            each cell, col in cells
              - const word = puzzle.words.find(item => item.x === row && item.y === col)
              - const cellClass = ['grid-cell', cell === '.' ? 'black' : '', col === 0 ? 'first-column' : '', row === 0 ? 'first-row' : ''].filter(Boolean).join(' ')
              div(class=cellClass data-cell data-row=row data-col=col style=`grid-column:${col + 2};grid-row:${row + 2}` role='gridcell' aria-label=`${row + 1}. errenkada, ${col + 1}. zutabea`)
                if word
                  span.i_words= word.number
                if cell !== '.'
                  span.char
        .active-clue-bar(role='status' data-active-clue)
        .history-bar
          button.btn.btn-sm.btn-outline-secondary(type='button' data-undo disabled)= t('game.undo')
          button.btn.btn-sm.btn-outline-secondary(type='button' data-redo disabled)= t('game.redo')
      section.clues.unselectable(aria-label=t('game.cluesLabel'))
        h2.clues-heading= t('game.across')
        .clues_across(data-clues='right')
          each group in groupedDefinitions('right')
            each word, index in group[1].sort((a, b) => a.y - b.y)
              .ipuz-clue-row
                if index === 0
                  span.clue-num= `${group[0] + 1}.`
                button.clue-item.clue-line(type='button' data-clue-dir=word.dir data-clue-x=word.x data-clue-y=word.y)= displayClue(word.clue)
        h2.clues-heading= t('game.down')
        .clues_down(data-clues='down')
          each group in groupedDefinitions('down')
            each word, index in group[1].sort((a, b) => a.x - b.x)
              .ipuz-clue-row
                if index === 0
                  span.clue-num= `${group[0] + 1}.`
                button.clue-item.clue-line(type='button' data-clue-dir=word.dir data-clue-x=word.x data-clue-y=word.y)= displayClue(word.clue)
        label.clue-layout-option
          input(type='checkbox' data-american-mode)
          span= t('game.americanMode')
    .game-notification-bar(role='status' data-game-notice)
    nav.game-actions(data-game-buttons aria-label=t('game.actions'))
      section.game-action-group(role='group' aria-label=t('game.check'))
        h2.game-action-title= t('game.check')
        button.btn.btn-outline-secondary(type='button' data-action='check-cell')= t('game.checkLetter')
        button.btn.btn-outline-secondary(type='button' data-action='check-word')= t('game.checkWord')
      section.game-action-group(role='group' aria-label=t('game.hint'))
        h2.game-action-title= t('game.hint')
        button.btn.btn-outline-secondary(type='button' data-action='solve-cell')= t('game.revealLetter')
        button.btn.btn-outline-secondary(type='button' data-action='solve-word')= t('game.revealWord')
        button.btn.btn-outline-secondary(type='button' data-action='solve-grid')= t('game.revealGrid')
      section.game-action-group.game-action-group--manage(role='group' aria-label=t('game.actions'))
        h2.game-action-title= t('game.actions')
        button.btn.btn-outline-danger(type='button' data-action='clear-grid')= t('game.clearGrid')
        button.btn.btn-primary.btn-check-grid(type='button' data-action='check-grid')= t('game.checkGrid')
        button.btn.btn-outline-secondary.btn-restart(type='button' data-action='restart' hidden=!puzzle.completed)= t('game.playAgain')
