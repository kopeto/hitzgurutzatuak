if data.breadcrumbs.length
  nav.group-breadcrumbs(aria-label=t('groups.breadcrumbs'))
    each crumb in data.breadcrumbs
      a(href=crumb.url)= crumb.name
      span(aria-hidden='true') /
    span(aria-current='page')= data.group.name
section.page-heading
  .page-heading-copy
    h1= data.group.name
if data.group.description.trim()
  section.group-description(aria-label=t('groups.description'))
    p= data.group.description
if data.children.length
  nav.group-links(aria-label=t('groups.subgroups'))
    each child in data.children
      a.group-link(href=child.url)
        span= child.name
if data.group.systemKey !== 'root' && data.puzzles.length
  section.catalog-games(aria-label=t('groups.games'))
    include ../includes/puzzle-list.pug
