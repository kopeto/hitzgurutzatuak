extends layout

block content
  .dashboard
    .page-heading
      .page-heading-copy
        p.eyebrow #{t('dashboard.eyebrow')}
        h1.dashboard-title #{t('dashboard.title')}
        p #{t('dashboard.intro')}
      a.btn.btn-outline-primary(href='/jokoak') #{t('home.browse')}

    .dashboard-stats-row
      .stat-card
        .stat-value #{stats.completed}
        .stat-label #{t('dashboard.completed')}
      .stat-card
        .stat-value #{stats.inProgress}
        .stat-label #{t('dashboard.inProgress')}
      .stat-card
        .stat-value #{stats.total}
        .stat-label #{t('dashboard.all')}

    if completed.length
      h2.dashboard-section-title ✓ #{t('dashboard.completed')}
      table.table.table-sm.table-hover
        thead
          tr
            th #{t('common.name')}
            th #{t('common.size')}
            th #{t('dashboard.completedAt')}
            th #{t('dashboard.duration')}
        tbody
          each s in completed
            tr
              td
                a(href=`/jokoak/game/${s.puzzleId}`) #{s.puzzle ? s.puzzle.name : s.puzzleId}
              td #{s.puzzle ? s.puzzle.width + '×' + s.puzzle.height : '—'}
              td #{new Date(s.completedAt).toLocaleDateString('eu')}
              td
                if s.durationSeconds != null
                  - const minutes = Math.floor(s.durationSeconds / 60)
                  - const seconds = s.durationSeconds % 60
                  | #{minutes} min #{String(seconds).padStart(2, '0')} s
                else
                  | —

    if inProgress.length
      h2.dashboard-section-title ⏳ #{t('dashboard.inProgress')}
      table.table.table-sm.table-hover
        thead
          tr
            th #{t('common.name')}
            th #{t('common.size')}
            th #{t('dashboard.startedAt')}
            th
        tbody
          each s in inProgress
            tr
              td #{s.puzzle ? s.puzzle.name : s.puzzleId}
              td #{s.puzzle ? s.puzzle.width + '×' + s.puzzle.height : '—'}
              td #{new Date(s.startedAt).toLocaleDateString('eu')}
              td
                a.btn.btn-sm.btn-outline-primary(href=`/jokoak/game/${s.puzzleId}`) #{t('common.continue')}

    if !completed.length && !inProgress.length
      p.text-muted #{t('dashboard.empty')}
      a.btn.btn-primary(href='/jokoak') #{t('dashboard.viewPuzzles')}
