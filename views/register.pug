extend layout

block content
  section.auth-layout
    .auth-intro
      p.eyebrow #{t('auth.registerEyebrow')}
      h1 #{t('auth.registerTitle')}
      p #{t('auth.registerText')}
    .auth-card
      h2 #{t('nav.createAccount')}
      form.auth-form(method='POST', action='/users/register')
        .form-group
          label(for='email') #{t('auth.email')}
          input#email.form-control(name='email', type='email', autocomplete='email', required)
        .form-group
          label(for='username') #{t('auth.username')}
          input#username.form-control(name='username', type='text', autocomplete='username', minlength='3', maxlength='40', required)
          small.form-hint #{t('auth.usernameHint')}
        .form-group
          label(for='password') #{t('auth.password')}
          input#password.form-control(name='password', type='password', autocomplete='new-password', minlength='4', required)
          small.form-hint #{t('auth.passwordHint')}
        .form-group
          label(for='password2') #{t('auth.repeatPassword')}
          input#password2.form-control(name='password2', type='password', autocomplete='new-password', required)
        button.btn.btn-primary.btn-block(type='submit') #{t('nav.createAccount')}
      p.auth-footer #{t('auth.haveAccount')} #[a(href='/users/login') #{t('nav.signIn')}]

