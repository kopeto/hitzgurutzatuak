extends layout

block scripts
  script#spiral-data(type='application/json') !{JSON.stringify(puz.spiral || {})}
  script(src='/scripts/spiral_game.js')

block styles
  link(rel='stylesheet', href='/style/spiral.css')

block content
  .game-topbar
    a(href='/jokoak')
      button.btn.btn-sm.btn-outline-secondary #{t('common.back')}
    h2.game-title #{puz.name}

  .game-wrapper(data-puzzle-id=puz.id data-completed=puz.completed ? 'true' : 'false')
    .spiral-layout
      .spiral-board-card
        if puz.spiral && puz.spiral.cells && puz.spiral.cells.length
          svg#spiral-board(viewBox=(puz.spiral.viewBox || '0 0 700 700') role='img' aria-label=`${puz.name} espiral jokoa`)
            each cell in puz.spiral.cells
              path.spiral-cell(id=`s_cell_${cell.index}` d=cell.path data-index=cell.index)
            each cell in puz.spiral.cells
              if cell.labelX !== null && cell.labelY !== null
                text.spiral-order(x=cell.labelX y=cell.labelY text-anchor='middle' dominant-baseline='middle') #{cell.index}
            each cell in puz.spiral.cells
              text.spiral-letter(id=`s_char_${cell.index}` x=cell.x y=cell.y text-anchor='middle' dominant-baseline='central' data-index=cell.index) ·
        else
          p.text-muted Ez dago espiral daturik puzzle honetan.
        #spiral-message.game-notification-bar(role='status' aria-live='polite')

      aside.spiral-panel
        h3.spiral-panel-title #{t('game.cluesLabel')}
        if puz.spiral && puz.spiral.clues && puz.spiral.clues.length
          ol.spiral-clues
            each clue in puz.spiral.clues
              li= clue
        else
          p.text-muted Ez dago pistarik.

        .spiral-status
          p
            strong Idatzita:
            |  
            span#spiral-count 0
            |  / #{puz.width}

        .spiral-actions
          button#spiral-check.btn.btn-primary(type='button') #{t('game.checkGrid')}
          button#spiral-clear.btn.btn-outline-danger(type='button') #{t('game.clearGrid')}
          if user
            button#spiral-restart.btn.btn-outline-secondary(type='button') #{t('game.playAgain')}
