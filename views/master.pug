extends layout

block content
  .dashboard
    .page-heading
      .page-heading-copy
        p.eyebrow #{t('upload.eyebrow')}
        h1.dashboard-title #{t('master.title')}
        p #{t('master.intro')}

    .dashboard-stats-row
      .stat-card
        .stat-value #{stats.puzzles}
        .stat-label #{t('master.puzzleCount')}
      .stat-card
        .stat-value #{stats.users}
        .stat-label #{t('master.userCount')}
      .stat-card
        .stat-value #{stats.completions}
        .stat-label #{t('master.completionCount')}
      .stat-card
        .stat-value #{stats.activeSessions}
        .stat-label #{t('common.active')}

    .dashboard-actions
      a.btn.btn-primary(href='/jokoak/upload') #{t('master.upload')}
    h4.dashboard-section-title #{t('master.externalApi')}
    .card.mb-4
      .card-body
        p.mb-2 #{t('master.apiDescription')}
        p.mb-0.text-muted #{t('master.apiSecret')}

    //- Deskargak master erabiltzaileentzat soilik daude ikusgai.
    h5.mt-3 #{t('master.downloads')}
    if downloadsFiles && downloadsFiles.length
      .card.mb-3
        .card-body.p-2
          table.table.table-sm.mb-0
            thead
              tr
                th #{t('common.name')}
                th.text-right #{t('common.size')}
                th #{t('common.date')}
            tbody
              each f in downloadsFiles
                tr
                  td
                    a(href=`/master/download/${encodeURIComponent(f.name)}`) #{f.name}
                  td.text-right #{f.sizeDisplay}
                  td #{f.mtimeDisplay}
    else
      p.text-muted.mb-4 #{t('master.downloadsEmpty')}

    h4.dashboard-section-title #{t('nav.puzzles')}
    table.table.table-sm.table-hover
      thead
        tr
          th #{t('common.name')}
          th #{t('common.size')}
          th #{t('common.author')}
          th #{t('master.completionCountShort')}
          th #{t('master.published')}
          th
      tbody
        each p in puzzles
          tr
            td #{p.name}
            td #{p.width}×#{p.height}
            td #{p.author || '—'}
            td.text-center #{completionMap[p._id] || 0}
            td #{p.createdAt ? new Date(p.createdAt).toLocaleDateString('eu') : '—'}
            td
              a.btn.btn-sm.btn-outline-secondary(href=`/jokoak/game/${p._id}`) #{t('common.play')}

    h4.dashboard-section-title #{t('master.users')}
    table.table.table-sm.table-hover
      thead
        tr
          th #{t('auth.username')}
          th #{t('common.authorEmail')}
          th #{t('common.manager')}
          th #{t('dashboard.completed')}
          th #{t('common.active')}
      tbody
        each u in users
          tr
            td #{u.username}
            td #{u.email}
            td
              if u.master
                span.badge.badge-warning #{t('common.authorized')}
            td.text-center #{userStats[u._id] ? userStats[u._id].completed : 0}
            td.text-center #{userStats[u._id] ? userStats[u._id].inProgress : 0}

    h4.dashboard-section-title #{t('master.recentCompletions', { count: recentCompletions.length })}
    table.table.table-sm
      thead
        tr
          th #{t('auth.username')}
          th #{t('nav.puzzles')}
          th #{t('common.date')}
      tbody
        each s in recentCompletions
          tr
            td #{s.username || s.userId}
            td #{s.puzzleName || s.puzzleId}
            td #{new Date(s.completedAt).toLocaleDateString('eu')}
