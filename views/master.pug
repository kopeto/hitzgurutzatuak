extends layout

block content
  .dashboard
    h2.dashboard-title ⚙️ Master panela

    .dashboard-stats-row
      .stat-card
        .stat-value #{stats.puzzles}
        .stat-label Puzle guztira
      .stat-card
        .stat-value #{stats.users}
        .stat-label Erabiltzaile
      .stat-card
        .stat-value #{stats.completions}
        .stat-label Osatze guztira
      .stat-card
        .stat-value #{stats.activeSessions}
        .stat-label Abian

    .dashboard-actions
      a.btn.btn-primary(href='/puzzles/upload') ⬆ Puzle berria igo
    h4.dashboard-section-title 🔑 API kanpokoa
    .card.mb-4
      .card-body
        p.mb-2 Kanpoko programetatik puzleak igotzeko API gakoa:
        .d-flex.align-items-center
          button.btn.btn-sm.btn-outline-secondary.mr-2#toggleApiKey(type='button', onclick='toggleApiKey()') 👁 Erakutsi
          code#apiKeyValue(style='display:none; word-break:break-all; background:#f5f5f5; padding:4px 8px; border-radius:4px; flex:1') #{externalApiKey}
          button.btn.btn-sm.btn-outline-primary.ml-2#copyApiKey(type='button', style='display:none', onclick='copyApiKey()') 📋 Kopiatu
        small#copyFeedback.text-success.d-block.mt-1(style='display:none !important')

    //- Downloads list (only visible to master users since route is protected)
    h5.mt-3 Fitxategiak deskargatzeko
    if downloadsFiles && downloadsFiles.length
      .card.mb-3
        .card-body.p-2
          table.table.table-sm.mb-0
            thead
              tr
                th Izena
                th.text-right Neurria
                th Data
            tbody
              each f in downloadsFiles
                tr
                  td
                    a(href=`/master/download/${encodeURIComponent(f.name)}`) #{f.name}
                  td.text-right #{f.sizeDisplay}
                  td #{f.mtimeDisplay}
    else
      p.text-muted.mb-4 Ez da fitxategirik `/downloads` karpetan.

    h4.dashboard-section-title Puzleak
    table.table.table-sm.table-hover
      thead
        tr
          th Izena
          th Neurria
          th Egilea
          th Osatze kop.
          th Argitaratua
          th
      tbody
        each p in puzzles
          tr
            td #{p.name}
            td #{p.width}×#{p.height}
            td #{p.author || '—'}
            td.text-center #{completionMap[p._id] || 0}
            td #{p.createdAt ? new Date(p.createdAt).toLocaleDateString('eu') : '—'}
            td
              a.btn.btn-sm.btn-outline-secondary(href=`/puzzles/game/${p._id}`) Jokatu

    h4.dashboard-section-title Erabiltzaileak
    table.table.table-sm.table-hover
      thead
        tr
          th Erabiltzailea
          th Posta
          th Master
          th Osatutakoak
          th Abian
      tbody
        each u in users
          tr
            td #{u.username}
            td #{u.email}
            td
              if u.master
                span.badge.badge-warning Master
            td.text-center #{userStats[u._id] ? userStats[u._id].completed : 0}
            td.text-center #{userStats[u._id] ? userStats[u._id].inProgress : 0}

    h4.dashboard-section-title.mt-4 Azken osatze (#{recentCompletions.length})

    h4.dashboard-section-title Azken osatze (#{recentCompletions.length})
    table.table.table-sm
      thead
        tr
          th Erabiltzailea
          th Puzlea
          th Data
      tbody
        each s in recentCompletions
          tr
            td #{s.username || s.userId}
            td #{s.puzzleName || s.puzzleId}
            td #{new Date(s.completedAt).toLocaleDateString('eu')}

  script.
    function toggleApiKey() {
      var val = document.getElementById('apiKeyValue');
      var btn = document.getElementById('toggleApiKey');
      var copyBtn = document.getElementById('copyApiKey');
      if (!val) return;
      if (val.style.display === 'none' || val.style.display === '') {
        val.style.display = 'inline';
        if (copyBtn) copyBtn.style.display = 'inline-block';
        if (btn) btn.textContent = '🙈 Ezkutatu';
      } else {
        val.style.display = 'none';
        if (copyBtn) copyBtn.style.display = 'none';
        if (btn) btn.textContent = '👁 Erakutsi';
      }
    }
    function copyApiKey() {
      var el = document.getElementById('apiKeyValue');
      if (!el) return;
      var text = el.textContent || el.innerText || '';
      if (!navigator.clipboard) return;
      navigator.clipboard.writeText(text).then(function() {
        var fb = document.getElementById('copyFeedback');
        if (fb) {
          fb.textContent = '✓ Kopiatuta!';
          fb.style.display = 'block';
          setTimeout(function() { fb.style.display = 'none'; }, 2000);
        }
      }).catch(function(err){ console.error('Clipboard error', err); });
    }
