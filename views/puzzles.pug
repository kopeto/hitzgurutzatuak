extends layout

block styles
  style.
    .puzzle-table {
      border-radius: 10px;
      overflow: hidden;
      box-shadow: 0 4px 18px rgba(0,0,0,0.10);
    }
    .puzzle-table thead {
      background: #343a40;
      color: #fff;
      letter-spacing: 0.04em;
      font-size: 0.93rem;
    }
    .puzzle-table tbody tr {
      transition: background 0.15s;
    }
    .puzzle-table tbody tr:hover {
      background: #f0f4ff;
    }
    .grid-badge {
      display: inline-block;
      padding: 3px 10px;
      border-radius: 20px;
      background: #e9ecef;
      font-family: monospace;
      font-size: 0.92rem;
      font-weight: 600;
      color: #495057;
    }
    .play-btn {
      width: 90px;
    }
    .status-badge {
      display: inline-block;
      padding: 2px 9px;
      border-radius: 20px;
      font-size: 0.82rem;
      font-weight: 600;
    }
    .status-started     { background: #fff3cd; color: #856404; }
    .status-completed   { background: #d1e7dd; color: #0a3622; }
    .status-notstarted  { background: #e9ecef; color: #6c757d; }
    .status-errors      { background: #fff3cd; color: #856404; }
    .status-help        { background: #fff3cd; color: #856404; }
    .status-laguntza    { font-style: italic; font-weight: 400; }
    .puzzle-title {
      font-weight: 600;
      color: #212529;
    }
    .puzzle-author {
      color: #6c757d;
      font-size: 0.9rem;
    }
    .upload-panel {
      background: #f8f9fa;
      border-radius: 10px;
      padding: 1.2rem 1.5rem;
      border: 1px solid #dee2e6;
    }

block content
  .d-flex.align-items-center.justify-content-between.mb-4
    h2.mb-0 #{title}
    if user && user.master
      button.btn.btn-sm.btn-outline-secondary(type='button' data-toggle='collapse' data-target='#uploadPanel') 
        | &#8679; Kargatu puzlea

  if user && user.master
    .collapse.mb-4#uploadPanel
      .upload-panel
        form(method='POST', action='/puzzles/upload', enctype='multipart/form-data')
          .form-row.align-items-end
            .col-auto
              label.sr-only(for='fileInput') Fitxategia
              input.form-control#fileInput(name='filename', type='file', accept='.puz', required)
            .col-auto
              input.btn.btn-primary(type='submit', value='Kargatu')

  if puzzles.length === 0
    .alert.alert-info Ez dago puzlerik oraindik.
  else
    .table-responsive
      table.table.table-hover.puzzle-table.mb-0
        thead
          tr
            th #
            th Izena
            th Egilea
            th Tamaina
            th Hitzak
            if user
              th Egoera
            th
              if user && user.master
                | Ekintzak
        tbody
          each puz, i in puzzles
            tr
              td.align-middle.text-muted.small #{i + 1}
              td.align-middle
                a.puzzle-title(href='/puzzles/game/' + puz.id) #{puz.name}
              td.align-middle
                span.puzzle-author #{puz.author}
              td.align-middle
                span.grid-badge #{puz.width}&times;#{puz.height}
              td.align-middle.text-center #{puz.words.length}
              if user
                td.align-middle
                  - const st = statusMap && statusMap[puz._id.toString()]
                  if st && st.status === 'completed'
                    - const sec = st.elapsedSeconds || 0
                    - const h = Math.floor(sec / 3600)
                    - const m = Math.floor((sec % 3600) / 60)
                    - const s = sec % 60
                    - const timeStr = (h > 0 ? h+':'+String(m).padStart(2,'0') : String(m).padStart(2,'0')) + ':' + String(s).padStart(2,'0')
                    - const perfect = st.errorCount === 0 && !st.usedVerify && !st.usedHints
                    - const hasHelp = st.usedVerify || st.usedHints
                    - const hasErrors = st.errorCount > 0
                    if perfect
                      span.status-badge.status-completed ✓ #{timeStr} · 0 akats
                    else if hasErrors && !hasHelp
                      span.status-badge.status-errors ✓ #{timeStr} · #{st.errorCount} akats
                    else if !hasErrors && hasHelp
                      span.status-badge.status-help ✓ #{timeStr} · 0 akats · 
                        em.status-laguntza laguntza
                    else
                      span.status-badge.status-help ✓ #{timeStr} · #{st.errorCount} akats · 
                        em.status-laguntza laguntza
                  else if st && st.status === 'started'
                    span.status-badge.status-started ⏳ Jokoan
                  else
                    span.status-badge.status-notstarted Hasi Gabea
              td.align-middle.text-right
                a.btn.btn-primary.btn-sm.play-btn(href='/puzzles/game/' + puz.id) &#9654; Jokatu
                if user && user.master
                  |  
                  button.btn.btn-outline-danger.btn-sm.deletePUZ(data-id=puz._id) Ezabatu
