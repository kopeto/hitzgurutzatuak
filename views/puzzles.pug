extends layout

block content
  section.page-heading
    .page-heading-copy
      p.eyebrow #{t('catalog.eyebrow')}
      h1 #{t('catalog.title')}
      p #{t('catalog.intro')}
    if user && user.master
      a.btn.btn-outline-primary(href='/jokoak/upload') #{t('catalog.upload')}

  if user && user.master
    aside.admin-note
      strong #{t('catalog.adminMode')}
      |  #{t('catalog.adminText')}

  if puzzles.length === 0
    .empty-state
      h2 #{t('catalog.emptyTitle')}
      if user && user.master
        p #{t('catalog.emptyAdmin')}
        a.btn.btn-primary(href='/jokoak/upload') #{t('catalog.upload')}
      else
        p #{t('catalog.emptyPlayer')}
  else
    .catalog-controls(data-catalog-controls)
      label.search-field(for='puzzleSearch')
        span #{t('catalog.search')}
        input#puzzleSearch.form-control(type='search' placeholder=t('catalog.searchPlaceholder') autocomplete='off' data-puzzle-search)
      if user
        label.filter-field(for='puzzleStatus')
          span #{t('catalog.status')}
          select#puzzleStatus.form-control(data-puzzle-status)
            option(value='all') #{t('common.all')}
            option(value='started') #{t('catalog.inProgress')}
            option(value='completed') #{t('catalog.completed')}
            option(value='notstarted') #{t('catalog.notStarted')}
      p.catalog-count(data-catalog-count) #{puzzles.length} puzle

    .puzzle-list(data-puzzle-catalog)
      each puz in puzzles
        - const st = user && statusMap ? statusMap[puz._id.toString()] : null
        - const status = st ? st.status : 'notstarted'
        article.puzzle-list-item(data-puzzle-card data-search=`${puz.name} ${puz.author || ''}` data-status=status)
          .puzzle-list-dimension #{puz.width}×#{puz.height}
          .puzzle-list-content
            h2
              a(href=`/jokoak/game/${puz._id}`) #{puz.name}
            p.puzzle-author #{puz.author || t('common.unknownAuthor')}
            .puzzle-list-details
              if st && status === 'completed'
                - const totalSeconds = st.elapsedSeconds || 0
                - const minutes = Math.floor(totalSeconds / 60)
                - const seconds = totalSeconds % 60
                span ✓ #{minutes} min #{String(seconds).padStart(2, '0')} s
                if st.errorCount
                  if st.errorCount === 1
                    span #{t('catalog.oneError')}
                  else
                    span #{st.errorCount} #{t('catalog.errors')}
                else if !st.usedVerify && !st.usedHints
                  span #{t('catalog.perfect')}
              else if st && status === 'started'
                span #{t('catalog.savedGame')}
              else
                span #{t('catalog.ready')}
              span #{puz.createdAt ? new Date(puz.createdAt).toLocaleDateString('eu') : '—'}
          .puzzle-list-status
            if status === 'completed'
              span.status-pill.status-pill--complete #{t('catalog.completed')}
            else if status === 'started'
              span.status-pill.status-pill--progress #{t('catalog.inProgress')}
            else
              span.status-pill #{t('catalog.notStarted')}
          .puzzle-list-actions
            if user && status === 'started'
              a.btn.btn-primary(href=`/jokoak/game/${puz._id}`) #{t('common.continue')}
            else
              a.btn.btn-primary(href=`/jokoak/game/${puz._id}`) #{t('common.play')}
            if user && user.master
              button.btn.btn-outline-danger.deletePUZ(type='button' data-id=puz._id data-name=puz.name) #{t('common.delete')}
