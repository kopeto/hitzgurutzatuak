extends layout

block styles
  link(rel='stylesheet', href='/style/spiral_builder_pdf.css')

block scripts
  script(src='/scripts/spiral_builder_pdf.js')

block content
  section.spiral-builder-shell
    aside.spiral-builder-aside
      p.spiral-builder-intro #{t('spiralBuilder.intro')}

      .spiral-builder-status(role='status' aria-live='polite' data-builder-status) #{t('spiralBuilder.downloadReady')}
      .spiral-builder-meta(data-builder-meta) —

      form#spiral-builder-form(autocomplete='off')
        .builder-row
          .builder-field
            label(for='builderTitle') #{t('spiralBuilder.titleField')}
            input#builderTitle.form-control(type='text', name='title', maxlength='120', placeholder=t('spiralBuilder.placeholderTitle'))
          .builder-field
            label(for='builderAuthor') #{t('spiralBuilder.authorField')}
            input#builderAuthor.form-control(type='text', name='author', maxlength='120', placeholder=t('spiralBuilder.placeholderAuthor'))

        .builder-row
          .builder-field
            label(for='builderCellCount') #{t('spiralBuilder.cellCount')}
            input#builderCellCount.form-control(type='number', name='cellCount', min='1', max='400', step='1', value='64')
          .builder-field
            label(for='builderCellSize') #{t('spiralBuilder.cellSize')}
            input#builderCellSize.form-control(type='number', name='cellSize', min='12', max='120', step='1', value='60')

        .builder-row
          .builder-field
            .clue-editor-heading
              label(for='builderInwardClues') #{t('spiralBuilder.inward')}
              button.clue-add-btn.btn.btn-outline-secondary.btn-sm(type='button' data-add-clue='inward' aria-label=t('spiralBuilder.addDefinition') title=t('spiralBuilder.addDefinition')) +
            .clue-editor(data-direction='inward')
              .clue-editor-list#builderInwardCluesList(data-clue-list='inward')
          .builder-field
            .clue-editor-heading
              label(for='builderOutwardClues') #{t('spiralBuilder.outward')}
              button.clue-add-btn.btn.btn-outline-secondary.btn-sm(type='button' data-add-clue='outward' aria-label=t('spiralBuilder.addDefinition') title=t('spiralBuilder.addDefinition')) +
            .clue-editor(data-direction='outward')
              .clue-editor-list#builderOutwardCluesList(data-clue-list='outward')

        .builder-field
          label(for='builderAnswer') #{t('spiralBuilder.answer')}
          textarea#builderAnswer.form-control(name='answer', rows='2', maxlength='512', placeholder=t('spiralBuilder.placeholderAnswer'))

        .spiral-builder-switch
          input#builderShowNumbers(type='checkbox', checked)
          label(for='builderShowNumbers') #{t('spiralBuilder.showNumbers')}

        #warning.spiral-builder-warning(role='alert')

        .builder-actions-panel
          .builder-actions-title Ekintzak
          .spiral-builder-actions
            button.btn.btn-primary(type='button' data-download-button) SPL-a deskargatu
            button.btn.btn-outline-danger(type='button' data-reset-builder) Reset

    main.spiral-builder-main
      article.spiral-page
        header.spiral-page-header
          .spiral-page-header__title(data-preview-title) THE SPIRAL
          .spiral-page-header__author(data-preview-author) BY STUART CLELAND
        .spiral-page-body
          .spiral-page-art
            svg#spiral-builder-preview.spiral-builder-preview(viewBox='0 0 760 760' role='img' aria-label=t('spiralBuilder.previewTitle'))
        .spiral-page-clues
          .spiral-clue-column
            h2 #{t('spiralBuilder.inward')}
            ol(data-inward-list)
          .spiral-clue-column
            h2 #{t('spiralBuilder.outward')}
            ol(data-outward-list)
