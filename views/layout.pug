doctype html
html(lang='eu')
  head
    title #{title} | #{t('site.name')}
    block meta
      meta(name='description' content=t('site.description'))
      meta(property='og:title' content=`${title} | ${t('site.name')}`)
      meta(property='og:description' content=t('site.description'))
      meta(property='og:type' content='website')
    meta(charset='utf-8')
    meta(name='viewport' content='width=device-width, initial-scale=1')
    link(rel='icon' type='image/svg+xml' href='/favicon.svg?v=20261004-2')
    link(rel='icon' href='/favicon.ico?v=20261004-2' sizes='any')
    
    link(rel='stylesheet' href='/style/style.css?v=20261002-2')
    link(rel='stylesheet' href='/vendor/bootstrap/css/bootstrap.min.css')
    script#i18n-data(type='application/json') !{JSON.stringify(clientMessages)}
    script(src='/scripts/i18n.js')
    script(src='/scripts/site.js' defer)
    block scripts
    block styles
  body.site-body
    include includes/site-header.pug
    main.site-main
      .site-shell
        != messages('message', locals)
        if errors
          each error, i in errors
            div(class='alert alert-danger') #{error.msg}
        block content
    include includes/site-footer.pug
    block footer
